---
import { categoryLabel, type Post } from '@atlas/contracts';
import { postUrl } from '../lib/posts';
interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const lang = post.translations['pt-BR'] ? 'pt-BR' : post.languages[0];
const copy = post.translations[lang]!;
const date = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString(lang, { day:'numeric',month:'short',year:'numeric',timeZone:'America/Sao_Paulo' }) : null;
---
<a class:list={['post-card', { featured }]} href={postUrl(post, lang)}>
  <div class="card-image"><img src={`/content/${post.id}/assets/cover.webp`} alt="" width="1200" height="800" loading={featured ? 'eager' : 'lazy'} /></div>
  <div class="card-copy"><div class="card-meta"><span class="eyebrow">{categoryLabel(post.category,lang)}</span>{post.status === 'draft' && <span class="draft">Rascunho</span>}</div><h2>{copy.title}</h2><p>{copy.summary}</p><div class="card-bottom"><span>{date || 'Em revisão'}</span><span class="read">Ler história ↗</span></div></div>
</a>
<style>.post-card{display:block}.card-image{overflow:hidden;border-radius:10px;background:#eef2f0}.card-image img{width:100%;aspect-ratio:1.5;object-fit:cover;transition:transform .25s}.post-card:hover img{transform:scale(1.025)}.card-copy{padding-top:20px}.card-meta{display:flex;align-items:center;gap:14px;margin-bottom:13px}.card-copy h2{font-size:23px;color:var(--ink);line-height:1.3;margin-bottom:12px}.card-copy p{font-size:14px;color:var(--muted);margin-bottom:24px}.card-bottom{display:flex;justify-content:space-between;gap:15px;font-size:12px;color:var(--muted)}.read{color:var(--accent);font-weight:600}.featured{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:center}.featured .card-copy{padding:0 20px 0 0}.featured .card-copy h2{font-size:clamp(28px,3vw,39px);letter-spacing:-1.1px}.featured .card-copy p{font-size:16px}.featured .card-bottom{margin-top:35px}@media(max-width:700px){.featured{grid-template-columns:1fr;gap:23px}.featured .card-copy{padding:0}.featured .card-copy h2{font-size:29px}}@media(prefers-reduced-motion:reduce){.card-image img{transition:none}}</style>
