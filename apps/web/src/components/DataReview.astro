---
import Base from '../layouts/Base.astro';
import {loadCandidate} from '../lib/candidate';
import {countryName,metricText,type Locale} from '../lib/i18n';
import {dataTr} from '../lib/data-i18n';
import {route} from '../lib/routes';
import spec from '../../../../datasets/sources/worldbank.json';
const {lang='en',review=false}=Astro.props as {lang?:Locale;review?:boolean};
const t=(key:Parameters<typeof dataTr>[1])=>dataTr(lang,key);
const candidate=await loadCandidate();
const count=candidate?.countries.length??0;
---
<Base title={t(review?'reviewTitle':'title')} lang={lang} noindex={review}>
<div class="container data-review" data-locale={lang} data-candidate-review={review?'true':undefined}>
<header class="page-heading"><span class="eyebrow">WWMAPS / WDI</span><h1>{t(review?'reviewTitle':'title')}</h1><p>{t('active')}</p></header>
{review&&<><p class="compare-notice">{t('pending')}</p>{candidate?<><div class="data-summary"><span><strong>{count}</strong> {t('countries')}</span><span><strong>{candidate.countries.filter(c=>c.mapAvailable).length}</strong> {t('mapped')}</span><span><strong>{candidate.years[0]}–{candidate.years.at(-1)}</strong> {t('allYears')}</span></div><p>{t('audit')}</p><p>{t('collected')}: <time>{candidate.importManifest!.retrievedAt}</time></p><p><a href="/data-review/candidate.json" download>{t('download')} ↓</a> · <a href="/data-review/audit.json" download>{t('report')} ↓</a></p><div class="review-controls"><label>{t('country')}<select id="review-country">{candidate.countries.map(c=><option value={c.id} selected={c.iso3==='BRA'}>{countryName(c.iso3,lang)}</option>)}</select></label><label>{t('year')}<select id="review-year">{candidate.years.map(y=><option selected={y===candidate.years.at(-1)}>{y}</option>)}</select></label><button id="review-export">{t('csv')}</button></div><div class="review-table-wrap"><table><caption>{t('pending')}</caption><thead><tr><th scope="col">{t('indicator')}</th><th scope="col">{t('value')}</th><th scope="col">{t('original')}</th><th scope="col">{t('reference')}</th></tr></thead><tbody id="review-observations"></tbody></table></div><p id="review-status" role="status"></p><p>{t('note')} {t('geometry')} {t('footnote')}</p><h2>{t('coverage')}</h2><div class="review-table-wrap"><table><caption>{candidate.years[0]}–{candidate.years.at(-1)}</caption><thead><tr><th scope="col">{t('indicator')}</th><th scope="col">{t('observations')}</th><th scope="col">{t('missing')}</th><th scope="col">{t('updated')}</th></tr></thead><tbody>{candidate.indicators.map(i=>{const n=Object.values(i.values).flat().filter(v=>v!==null).length;return <tr><th scope="row">{metricText(i.id,lang).label}</th><td>{n}</td><td>{count*candidate.years.length-n}</td><td>{i.provenance!.files[0].lastUpdated}</td></tr>;})}</tbody></table></div><noscript>{lang==='en'?'Enable JavaScript to inspect and export a selection. The complete JSON and coverage tables remain available.':'Ative JavaScript para inspecionar e exportar uma seleção. O JSON completo e as tabelas de cobertura continuam disponíveis.'}</noscript></>:<p>{t('notAvailable')}</p>}</>}
{!review&&<p><a class="button" href={route('dataReview',lang)}>{t('review')} ↗</a></p>}
<section class="indicator-definitions"><h2>{t('definitions')}</h2>{spec.indicators.map(def=>{const p=candidate?.indicators.find(i=>i.id===def.id)?.provenance;return <article id={def.id}><span class="eyebrow">{def.code}</span><h3>{metricText(def.id,lang).label}</h3><h4>{t('definition')}</h4><p>{def.definition[lang]}</p><h4>{t('limits')}</h4><p>{def.limitations[lang]}</p><dl><dt>{t('unit')}</dt><dd lang="en">{def.originalUnit}</dd><dt>{t('conversion')}</dt><dd>{t('divide')} {def.divisor.toLocaleString(lang)} → {metricText(def.id,lang).unit}</dd><dt>{t('source')}</dt><dd><a href={`https://data.worldbank.org/indicator/${def.code}`} target="_blank" rel="noopener">World Bank · WDI ↗</a></dd><dt>{t('license')}</dt><dd><a href={spec.license.url}>CC BY 4.0</a> · <a href={`https://data.worldbank.org/indicator/${def.code}`}>{t('source')}</a></dd>{p&&<><dt>{t('updated')}</dt><dd>{p.files[0].lastUpdated}</dd><dt>{t('collected')}</dt><dd>{p.files[0].retrievedAt}</dd></>}</dl>{p&&<details><summary>{t('sourceNote')}</summary><p lang="en">{p.sourceNote}</p><p lang="en">{p.sourceOrganization}</p></details>}</article>;})}</section>
</div></Base>
<script>
import type {DashboardData} from '@atlas/contracts';
import {dataTr} from '../lib/data-i18n';
import {metricText,countryName} from '../lib/i18n';
import {comparisonRows,comparisonCsv} from '../lib/comparison';
const root=document.querySelector<HTMLElement>('[data-candidate-review="true"]');
if(root&&document.getElementById('review-country')){
 const lang=root.dataset.locale==='pt-BR'?'pt-BR':'en';const t=(key:Parameters<typeof dataTr>[1])=>dataTr(lang,key);
 const country=document.getElementById('review-country') as HTMLSelectElement,year=document.getElementById('review-year') as HTMLSelectElement;
 const status=document.getElementById('review-status')!;
 fetch('/data-review/candidate.json').then(r=>{if(!r.ok)throw new Error('Candidate unavailable');return r.json();}).then((data:DashboardData)=>{
 function render(){const tbody=document.getElementById('review-observations')!;tbody.replaceChildren();const index=data.years.indexOf(Number(year.value));
 for(const i of data.indicators){const p=i.provenance!,value=i.values[country.value][index],raw=i.originalValues![country.value][index],ref=p.recordRefs[country.value][index];const row=document.createElement('tr');
 const label=document.createElement('th');label.scope='row';label.textContent=metricText(i.id,lang).label;row.append(label);
 for(const text of [value===null?t('noData'):`${value.toLocaleString(lang,{maximumFractionDigits:4})} ${metricText(i.id,lang).unit}`,raw===null?t('noData'):`${raw.toLocaleString(lang,{maximumFractionDigits:12})} · ${p.originalUnit}`]){const cell=document.createElement('td');cell.textContent=text;row.append(cell);}
 const cell=document.createElement('td');if(ref){const a=document.createElement('a');a.href=`/data-review/raw/${ref.file.split('/').at(-1)}`;a.target='_blank';a.rel='noopener';a.textContent=`${ref.file.split('/').at(-1)} · [1][${ref.index}]`;cell.append(a);}else cell.textContent=t('none');row.append(cell);tbody.append(row);}
 status.textContent=`${countryName(data.countries.find(c=>c.id===country.value)!.iso3,lang)} · ${year.value} · ${t('reviewState')}`;}
 country.addEventListener('change',render);year.addEventListener('change',render);render();
 document.getElementById('review-export')!.addEventListener('click',()=>{const rows=comparisonRows(data,[country.value],Number(year.value),lang);const url=URL.createObjectURL(new Blob([comparisonCsv(rows)],{type:'text/csv;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download=`wwmaps-candidate-PENDING-${country.value}-${year.value}.csv`;link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
 }).catch(error=>{status.textContent=String(error);});
}
</script>
<style>.data-review{padding-bottom:70px}.data-review a{color:var(--accent)}.data-summary,.review-controls{display:flex;flex-wrap:wrap;gap:24px;margin:24px 0}.data-summary span{padding:18px;background:#eee4f7;border-radius:8px}.data-summary strong{display:block;font-size:28px}.review-controls label{display:flex;flex-direction:column;gap:8px}.review-controls select,.review-controls button{padding:10px;border:1px solid var(--line);border-radius:6px;background:#fffaf1;color:var(--ink)}.review-controls button{align-self:end;background:#7132df;color:white}.review-table-wrap{overflow-x:auto;margin:20px 0}.review-table-wrap table{border-collapse:collapse;width:100%;background:#fffaf1;font-size:13px}.review-table-wrap :global(th),.review-table-wrap :global(td){border:1px solid var(--line);padding:12px;text-align:left}.review-table-wrap caption{text-align:left;font-size:11px;padding:8px 0;color:var(--muted)}.indicator-definitions{max-width:900px;margin-top:50px}.indicator-definitions article{border-top:1px solid var(--line);padding:28px 0}.indicator-definitions h3{font-size:25px}.indicator-definitions h4{margin-bottom:8px}.indicator-definitions p{font-size:14px}.indicator-definitions dl{display:grid;grid-template-columns:170px 1fr;gap:10px;font-size:13px}.indicator-definitions dd{margin:0;overflow-wrap:anywhere}.indicator-definitions dt{font-weight:600}.indicator-definitions summary{cursor:pointer;font-size:13px;padding:12px 0}@media(max-width:600px){.indicator-definitions dl{grid-template-columns:1fr}.data-summary{gap:10px}.review-controls select{max-width:100%}.review-table-wrap table{font-size:12px}}</style>
