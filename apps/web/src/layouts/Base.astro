---
import '../styles/global.css';
import InterfaceSprite from '../components/InterfaceSprite.astro';
import {interfaceSprites} from '../config/interface-sprites';
import '@fontsource/barlow-condensed/latin-800-italic.css';
import { tr, type Locale } from '../lib/i18n';
import { route, equivalents, localeFromPath } from '../lib/routes';
interface Props { title:string;description?:string;lang?:Locale;image?:string;noindex?:boolean;alternates?:Partial<Record<Locale,string>> }
const {title,lang=localeFromPath(Astro.url.pathname),description=tr(lang,'description'),image=lang==='en'?'/brand/wwmaps-social.png':'/brand/wwmaps-social-pt-br.png',noindex=false,alternates=equivalents(Astro.url.pathname)??undefined}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site??'https://wwmaps.com');
const nav=[['home','observatory'],['categories','categories'],['compare','compare'],['collection','collection']] as const;
const home=route('home',lang);
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · WWMaps</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}{alternates&&<>{Object.entries(alternates).map(([language,path])=><link rel="alternate" hreflang={language} href={new URL(path!,Astro.site??canonical)}/>)}{alternates.en&&<link rel="alternate" hreflang="x-default" href={new URL(alternates.en,Astro.site??canonical)}/>}</>}<meta property="og:site_name" content="WWMaps"/><meta property="og:locale" content={lang==='en'?'en_US':'pt_BR'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site??canonical)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="sitemap" href="/sitemap.xml"/><slot name="head"/></head><body>
<a class="skip" href="#main">{tr(lang,'skip')}</a><div class="header-wrap"><header class="site-header container"><a class="brand" href={home} aria-label={`WWMaps — ${tr(lang,'home')}`}><InterfaceSprite name="mascot" size={56} badge eager/>{!interfaceSprites.enabled&&<svg viewBox="0 0 32 32" width="29" height="29" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="1.6"/><ellipse cx="16" cy="16" rx="6" ry="13" stroke="currentColor" stroke-width="1.6"/><path d="M3 16h26M6 8h20M6 24h20" stroke="currentColor" stroke-width="1.3"/></svg>}<span>WWMAPS<span class="brand-light">.com</span></span></a><nav aria-label={tr(lang,'main')}>{nav.map(([page,key])=><a href={route(page,lang)} aria-current={Astro.url.pathname===route(page,lang)?'page':undefined}>{tr(lang,key)}</a>)}<a class="search-link" href={route('search',lang)}>{tr(lang,'search')}</a><div class="locale-switch" aria-label={tr(lang,'language')}>{(['en','pt-BR'] as const).map(language=><a data-language-switch href={alternates?.[language]??route('home',language)} lang={language} hreflang={language} aria-current={language===lang?'true':undefined} aria-label={language==='en'?'English':'Português brasileiro'}>{language==='en'?'EN':'PT-BR'}</a>)}</div></nav></header></div>
{import.meta.env.DEV&&<div class="local-studio-bar container"><a href="/__studio/">{lang==='en'?'Local studio · Edit content':'Painel local · Editar conteúdos'} ↗</a></div>}
<main id="main" tabindex="-1"><slot/></main>{Astro.url.pathname===home&&<a class="comparison-launcher" href={route('compare',lang)}><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 24V13m7 11V7m8 17V17m7 7V3" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg><span>{tr(lang,'launcher')}<small>{tr(lang,'launcherDetail')} ↗</small></span></a>}
<footer class="site-footer container"><div class="footer-identity"><a class="brand" href={home}>WWMAPS.com</a><span>{tr(lang,'tagline')}</span></div><div class="footer-crew" aria-hidden="true"><InterfaceSprite name="traveler" size={83}/><span class="crew-route"></span><InterfaceSprite name="gardener" size={92}/></div><div class="footer-links"><a href={route('about',lang)}>{tr(lang,'about')}</a><a href={route('methodology',lang)}>{tr(lang,'methodology')}</a></div></footer></body></html>
<script>
for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]')){const url=new URL(link.href);url.search=location.search;url.hash=location.hash;link.href=url.href;}
</script>
