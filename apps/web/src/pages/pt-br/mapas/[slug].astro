---
import Article from '../../../layouts/Article.astro';
import { getPosts } from '../../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).filter(p => p.languages.includes('pt-BR')).map(post => ({ params: { slug: post.translations['pt-BR']!.slug }, props: { post } })); }
const { post } = Astro.props;
---
<Article post={post} lang="pt-BR" />
