{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "official-candidate",
        "official"
      ]
    },
    "notice": {
      "type": "string",
      "minLength": 20
    },
    "years": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "countries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{3}$"
          },
          "iso3": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "iso2": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mapAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "iso3",
          "name"
        ]
      }
    },
    "indicators": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "geography",
              "history",
              "economy",
              "geopolitics",
              "culture",
              "environment",
              "society",
              "technology",
              "brazil",
              "regional-intelligence",
              "travel"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "code": {
                "type": "string"
              },
              "api": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url",
              "code",
              "api"
            ]
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "originalValues": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "World Bank"
              },
              "sourceId": {
                "type": "string",
                "const": "2"
              },
              "indicatorCode": {
                "type": "string"
              },
              "originalUnit": {
                "type": "string"
              },
              "divisor": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "const": "CC-BY-4.0"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "evidenceUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "id",
                  "url",
                  "evidenceUrl"
                ]
              },
              "definition": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pt-BR": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "en",
                  "pt-BR"
                ]
              },
              "limitations": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pt-BR": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "en",
                  "pt-BR"
                ]
              },
              "sourceNote": {
                "type": "string"
              },
              "sourceOrganization": {
                "type": "string"
              },
              "metadataFiles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "retrievedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "lastUpdated": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "url",
                    "retrievedAt",
                    "lastUpdated"
                  ]
                }
              },
              "files": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "retrievedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "lastUpdated": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "url",
                    "retrievedAt",
                    "lastUpdated"
                  ]
                }
              },
              "recordRefs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "file",
                          "index"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "seriesReview": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "approved",
                        "rejected"
                      ]
                    },
                    "reviewer": {
                      "type": "string"
                    },
                    "reviewedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "provider",
              "sourceId",
              "indicatorCode",
              "originalUnit",
              "divisor",
              "attribution",
              "license",
              "definition",
              "limitations",
              "sourceNote",
              "sourceOrganization",
              "metadataFiles",
              "files",
              "recordRefs",
              "seriesReview"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "category",
          "unit",
          "source",
          "values"
        ]
      }
    },
    "importManifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "countryFiles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "lastUpdated": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "url",
              "retrievedAt",
              "lastUpdated"
            ]
          }
        },
        "mappingPackage": {
          "type": "string"
        },
        "countryMapping": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "iso3": {
                "type": "string"
              },
              "iso2": {
                "type": "string"
              }
            },
            "required": [
              "iso3",
              "iso2"
            ]
          }
        }
      },
      "required": [
        "id",
        "retrievedAt",
        "countryFiles",
        "mappingPackage",
        "countryMapping"
      ]
    }
  },
  "required": [
    "mode",
    "notice",
    "years",
    "countries",
    "indicators"
  ]
}
