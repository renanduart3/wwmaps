{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/studio/src/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "apps/web/functions/**/*.ts"]
}
